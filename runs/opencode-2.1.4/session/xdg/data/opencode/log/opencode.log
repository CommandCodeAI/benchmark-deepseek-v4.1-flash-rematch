timestamp=2026-10-26T00:41:10.631Z level=INFO run=08028ea0 message="spawning process" command=git args="[\"--git-dir\",\"/work/bench2/opencode2/xdg/data/opencode/snapshot/global/48fbfe3ba5b4077bf92f0461647888043b3c0df9\",\"--work-tree\",\"/work/bench2/opencode2/work\",\"ls-files\",\"--others\",\"--exclude-standard\",\"-z\",\"--\",\":(literal).\"]" cwd=/work/bench2/opencode2/work role=server
timestamp=2026-10-26T00:41:29.463Z level=INFO run=08028ea0 message="spawning process" command=/bin/bash args="[\"-c\",\"cd /work/bench2/opencode2/work && cp sim.js sim.softcap.js && python3 - <<'PY'\\nfrom pathlib import Path\\np=Path('sim.js'); s=p.read_text()\\n# Replace birth odds method with simple constants-ish\\nimport re\\nstart=s.index('    _birthOdds(kind) {')\\nend=s.index('    _weatherMultipliers() {')\\nmethod=\\\"\\\"\\\"    _birthOdds(kind) {\\n      if (kind === 'prey') {\\n        const canopy = this.currentCanopy == null ? 43 : this.currentCanopy;\\n        return clamp(0.075 * (canopy / 42) * (1 - this.prey.length / 620), 0, 0.14);\\n      }\\n      return clamp(0.12 * (this.prey.length / 250) * (1 - this.predators.length / 140), 0, 0.18);\\n    }\\n\\n\\\"\\\"\\\"\\ns=s[:start]+method+s[end:]\\n# cooldowns slower; maturity\\ns=s.replace(\\\"parent.cooldown = 92;\\\",\\\"parent.cooldown = 150;\\\")\\ns=s.replace(\\\"parent.cooldown = 165;\\\",\\\"parent.cooldown = 215;\\\")\\ns=s.replace(\\\"cooldown: 55,\\\\n        state: 'born',\\\",\\\"cooldown: 90,\\\\n        state: 'born',\\\")\\ns=s.replace(\\\"cooldown: 80,\\\\n        state: 'born',\\\",\\\"cooldown: 120,\\\\n        state: 'born',\\\")\\ns=s.replace(\\\"a.age > 58 && a.cooldown <= 0\\\",\\\"a.age > 58 && a.cooldown <= 0\\\")\\ns=s.replace(\\\"a.age > 92 && a.cooldown <= 0\\\",\\\"a.age > 95 && a.cooldown <= 0\\\")\\n# holders higher caps\\ns=s.replace(\\\"this.prey.length < 900\\\",\\\"this.prey.length < 620\\\")\\ns=s.replace(\\\"this.predators.length < 180\\\",\\\"this.predators.length < 140\\\")\\np.write_text(s)\\nPY\\nnode - <<'NODE'\\nrequire('./sim.js');\\nfor (const seed of [61904,42,1776,2026,999,31415,1234,8888]) {\\n  const r=Vivarium.runHeadless({seed,generations:36,mutationRate:.065,foodRegrowth:1,cataclysmInterval:6});\\n  const l=r.records.at(-1);\\n  console.log(seed,'prey',l.prey,'pred',l.predators,'canopy',l.canopy.toFixed(1),'peak',r.stats.peakPrey,r.stats.peakPredators,'ev',r.events.map(e=>e.type[0]+e.gen).join(','));\\n  console.log(' counts',r.records.map(x=>x.prey+'/'+x.predators).join(' '));\\n}\\nNODE\"]" cwd=/work/bench2/opencode2/work http.span=841504 role=server
