timestamp=2026-10-26T00:34:25.124Z level=INFO run=08028ea0 message="spawning process" command=/bin/bash args="[\"-c\",\"cd /work/bench2/opencode2/work && node - <<'NODE'\\nrequire('./sim.js');\\nconst seeds=[61904, 42, 1776, 2026, 999, 31415, 8888, 1234];\\nfor (const seed of seeds) {\\n  const t0=Date.now();\\n  const r=Vivarium.runHeadless({seed,generations:36,mutationRate:.065,foodRegrowth:1,cataclysmInterval:8});\\n  const recs=r.records;\\n  const last=recs[recs.length-1];\\n  console.log(seed, 'finished',r.generation,'ms',Date.now()-t0,'events',r.events.length, 'prey',last.prey,'pred',last.predators,'canopy',last.canopy.toFixed(0), 'peak',r.stats.peakPrey,r.stats.peakPredators, 'births',r.stats.births,'kills',r.stats.kills);\\n  console.log('  prey genes', ['speed','vision','metabolism','reproduction'].map(k=>k+':'+last.preyGenes[k].mean.toFixed(2)+'±'+last.preyGenes[k].std.toFixed(2)).join(' '));\\n  console.log('  pred genes', ['speed','vision','metabolism','reproduction'].map(k=>k+':'+last.predGenes[k].mean.toFixed(2)+'±'+last.predGenes[k].std.toFixed(2)).join(' '));\\n  console.log('  evs', r.events.map(e=>`g${e.gen}:${e.type}`).join(', '));\\n  console.log('  counts', recs.filter((_,i)=>i%4===0).map(x=>x.gen+':'+x.prey+'/'+x.predators).join(' '));\\n}\\nNODE\"]" cwd=/work/bench2/opencode2/work http.span=417165 role=server
