timestamp=2026-10-26T00:39:19.332Z level=INFO run=08028ea0 message="spawning process" command=/bin/bash args="[\"-c\",\"cd /work/bench2/opencode2/work && node - <<'NODE'\\nrequire('./sim.js');\\nconst r=Vivarium.runHeadless({seed:42,generations:36,mutationRate:.065,foodRegrowth:1,cataclysmInterval:8});\\nconsole.log('events'); r.events.forEach(e=>console.log(e.gen,e.type,e.impact));\\nconsole.log('canopy',r.records.map(x=>x.gen+':'+x.canopy.toFixed(0)).join(' '));\\nconsole.log('prey',r.records.map(x=>x.gen+':'+x.prey).join(' '));\\nconsole.log('pred',r.records.map(x=>x.gen+':'+x.predators).join(' '));\\nconsole.log('prey genes 0',JSON.stringify(r.records[0].preyGenes));\\nconsole.log('prey genes 36',JSON.stringify(r.records.at(-1).preyGenes));\\nconsole.log('pred genes 0',JSON.stringify(r.records[0].predGenes));\\nconsole.log('pred genes 36',JSON.stringify(r.records.at(-1).predGenes));\\nconsole.log('births',r.stats.births,'deaths',r.stats.deaths,'kills',r.stats.kills);\\nNODE\"]" cwd=/work/bench2/opencode2/work http.span=711373 role=server
