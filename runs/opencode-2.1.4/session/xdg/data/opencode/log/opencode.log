timestamp=2026-10-26T00:45:47.907Z level=INFO run=08028ea0 message="spawning process" command=/bin/bash args="[\"-c\",\"cd /work/bench2/opencode2/work && node - <<'NODE'\\nrequire('./sim.js');\\nlet rows=[];\\nfor (let seed=1000; seed<1080; seed++) {\\n  const r=Vivarium.runHeadless({seed,generations:36,mutationRate:.065,foodRegrowth:1,cataclysmInterval:6});\\n  const recs=r.records;\\n  const l=recs.at(-1);\\n  const prey=recs.map(x=>x.prey), pred=recs.map(x=>x.predators), can=recs.map(x=>x.canopy);\\n  const range=a=>Math.max(...a)-Math.min(...a);\\n  const variation=range(prey)+range(pred)*2+range(can)*2.5;\\n  const types=new Set(r.events.map(e=>e.type)).size;\\n  const minPrey=Math.min(...prey);\\n  if (minPrey>0 && l.prey>80 && l.predators>10 && types===3) {\\n    const drift = (l.preyGenes.speed.mean - recs[0].preyGenes.speed.mean) + (l.predGenes.speed.mean-recs[0].predGenes.speed.mean);\\n    rows.push({seed,variation:variation.toFixed(0),final:`${l.prey}/${l.predators}/${l.canopy.toFixed(0)}`,peak:[r.stats.peakPrey,r.stats.peakPredators],events:r.events.map(e=>e.type[0]+e.gen).join(''),drift:drift.toFixed(2),rangePrey:range(prey),rangePred:range(pred),canopyRange:range(can).toFixed(0)});\\n  }\\n}\\nrows.sort((a,b)=>b.variation-a.variation);\\nconsole.log(rows.slice(0,20));\\nconsole.log('count', rows.length);\\nNODE\"]" cwd=/work/bench2/opencode2/work http.span=1099948 role=server
