timestamp=2026-10-26T00:39:49.036Z level=INFO run=08028ea0 message="spawning process" command=/bin/bash args="[\"-c\",\"cd /work/bench2/opencode2/work && python3 - <<'PY'\\nfrom pathlib import Path\\np=Path('sim.js'); s=p.read_text()\\ns=s.replace(\\\"const cut = sorted[Math.floor(n * 0.41)];\\\",\\\"const cut = sorted[Math.floor(n * 0.585)];\\\")\\n# event scheduling and bag\\ns=s.replace(\\\"      this.eventSerial = 0;\\\",\\\"      this.eventSerial = 0;\\\\n      this.eventBag = [];\\\")\\ns=s.replace(\\\"      this.nextEventAt = this._initialEventAt();\\\\n      this._buildWorld();\\\",\\\"      this.nextEventAt = this._initialEventAt();\\\\n      this._buildWorld();\\\")\\ns=s.replace(\\\"    _initialEventAt() {\\\\n      if (!this.config.enabledCataclysms.length) return null;\\\\n      return Math.max(2, Math.ceil(this.config.cataclysmInterval * 0.55));\\\\n    }\\\", \\\"    _initialEventAt() {\\\\n      if (!this.config.enabledCataclysms.length) return null;\\\\n      return Math.max(2, Math.round(this.config.cataclysmInterval * 0.62));\\\\n    }\\\\n\\\\n    _nextCataclysmType() {\\\\n      const enabled = this.config.enabledCataclysms;\\\\n      if (!enabled.length) return null;\\\\n      if (!this.eventBag.length) {\\\\n        const last = this.events.length ? this.events[this.events.length - 1].type : null;\\\\n        const bag = enabled.filter(t => t !== last || enabled.length === 1);\\\\n        for (let i = bag.length - 1; i > 0; i--) {\\\\n          const j = Math.floor(this.rng() * (i + 1));\\\\n          const tmp = bag[i]; bag[i] = bag[j]; bag[j] = tmp;\\\\n        }\\\\n        this.eventBag = bag;\\\\n      }\\\\n      return this.eventBag.pop();\\\\n    }\\\")\\n# replace fire start selection\\ns=s.replace(\\\"      const enabled = this.config.enabledCataclysms;\\\\n      if (!enabled.length) return null;\\\\n      const type = enabled[Math.floor(this.rng() * enabled.length)];\\\\n      const meta = CATACLYSMS[type];\\\", \\\"      const type = this._nextCataclysmType();\\\\n      if (!type) return null;\\\\n      const meta = CATACLYSMS[type];\\\")\\ns=s.replace(\\\"        gen: this.generation + 1,\\\",\\\"        gen: this.generation,\\\")\\ns=s.replace(\\\"      this.nextEventAt = this.generation + 1 + this.config.cataclysmInterval;\\\",\\\"      this.nextEventAt = this.generation + this.config.cataclysmInterval;\\\")\\n# stronger drought\\nold=\\\"\\\"\\\"        for (let i = 0; i < this.plants.length; i++) {\\n          const b = this.plants[i];\\n          if (b > 0.01) {\\n            before += b;\\n            const kill = 0.35 + this.rng() * 0.32;\\n            this.plants[i] = b * kill;\\n            lost += b - this.plants[i];\\n          }\\n        }\\\"\\\"\\\"\\nnew=\\\"\\\"\\\"        for (let i = 0; i < this.plants.length; i++) {\\n          const b = this.plants[i];\\n          if (b > 0.01) {\\n            before += b;\\n            const kill = (i % 5 === 0) ? 0.64 + this.rng() * 0.18 : 0.05 + this.rng() * 0.2;\\n            this.plants[i] = b * kill;\\n            lost += b - this.plants[i];\\n          }\\n        }\\\"\\\"\\\"\\ns=s.replace(old,new)\\n# stronger frost coverage drop\\ns=s.replace(\\\"this.plants[i] *= 0.63 + this.rng() * 0.17;\\\",\\\"this.plants[i] *= 0.34 + this.rng() * 0.25;\\\")\\n# plague a little stronger\\ns=s.replace(\\\"if (this.rng() < 0.28) {\\\",\\\"if (this.rng() < 0.34) {\\\")\\n# pred K multiplier\\ns=s.replace(\\\"const softCap = Math.max(6, 4 + this.prey.length * 0.17);\\\",\\\"const softCap = Math.max(7, 4 + this.prey.length * 0.225);\\\")\\n# birth gate a bit stronger\\ns=s.replace(\\\"return clamp(0.58 * (1 - this.predators.length / softCap), 0, 0.5);\\\",\\\"return clamp(0.68 * (1 - this.predators.length / softCap), 0, 0.58);\\\")\\np.write_text(s)\\nPY\\nnode - <<'NODE'\\nrequire('./sim.js');\\nfor (const seed of [61904,42,1776,2026,999,31415,1234,8888]) {\\n  const t0=Date.now();\\n  const r=Vivarium.runHeadless({seed,generations:36,mutationRate:.065,foodRegrowth:1,cataclysmInterval:8});\\n  const l=r.records.at(-1);\\n  console.log(seed,'ms',Date.now()-t0,'prey',l.prey,'pred',l.predators,'canopy',l.canopy.toFixed(1),'peak',r.stats.peakPrey,r.stats.peakPredators,'events',r.events.map(e=>`g${e.gen}:${e.type}`).join(','));\\n  console.log(' counts',r.records.filter((_,i)=>i%3===0).map(x=>x.gen+':'+x.prey+'/'+x.predators+'/'+x.canopy.toFixed(0)).join(' '));\\n}\\nNODE\"]" cwd=/work/bench2/opencode2/work http.span=741077 role=server
